# Flask Environment Configuration
FLASK_ENV=development
FLASK_APP=backend/run.py
SECRET_KEY=your_flask_secret_key_here
DATABASE_URL=sqlite:///storage/forensic_system.db

# JWT & Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRES=86400

# Private Evidence Storage
UPLOAD_FOLDER=storage/evidence_vault
MAX_CONTENT_LENGTH=104857600  # 100 MB max file size

# Blockchain Node & Smart Contract
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
BLOCKCHAIN_PRIVATE_KEY=your_blockchain_private_key_here

# File Monitoring Configuration
MONITORING_DIR=storage/monitored_targets
MONITORING_INTERVAL=60  # seconds between integrity checks
